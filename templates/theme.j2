<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Theme Explorer — Higher Ed + AI Daily Briefing</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --bg-primary: #f5f5f4;
            --bg-secondary: #ffffff;
            --bg-tertiary: #e7e5e4;
            --text-primary: #1c1917;
            --text-secondary: #44403c;
            --text-muted: #78716c;
            --text-subtle: #a8a29e;
            --border-color: #d6d3d1;
            --accent-primary: #1e40af;
            --accent-hover: #1e3a8a;
            --accent-bg: #dbeafe;
            --shadow-sm: 0 1px 2px rgba(0,0,0,0.04);
            --shadow-md: 0 4px 6px rgba(0,0,0,0.06);
            --shadow-lg: 0 10px 15px rgba(0,0,0,0.08);
            --ai-badge-bg: #fef9c3;
            --ai-badge-text: #854d0e;
            --stats-bg: #f5f5f4;
            --header-border: #d6d3d1;
            --tag-bg: #eff6ff;
            --tag-text: #1e40af;
            --ai-score-bg: #fef9c3;
            --ai-score-text: #854d0e;
        }

        [data-theme="dark"] {
            --bg-primary: #0c0a09;
            --bg-secondary: #1c1917;
            --bg-tertiary: #292524;
            --text-primary: #fafaf9;
            --text-secondary: #d6d3d1;
            --text-muted: #a8a29e;
            --text-subtle: #78716c;
            --border-color: #292524;
            --accent-primary: #60a5fa;
            --accent-hover: #93c5fd;
            --accent-bg: #1e3a5f;
            --shadow-sm: 0 1px 2px rgba(0,0,0,0.4);
            --shadow-md: 0 4px 6px rgba(0,0,0,0.4);
            --shadow-lg: 0 10px 15px rgba(0,0,0,0.5);
            --ai-badge-bg: #713f12;
            --ai-badge-text: #fde047;
            --stats-bg: #1c1917;
            --header-border: #292524;
            --tag-bg: #1e3a5f;
            --tag-text: #93c5fd;
            --ai-score-bg: #713f12;
            --ai-score-text: #fde047;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
            line-height: 1.65;
            color: var(--text-primary);
            background: var(--bg-primary);
            max-width: 100%;
            margin: 0;
            padding: 0;
            transition: background-color 0.3s ease, color 0.3s ease;
        }

        .app-container {
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            width: 280px;
            background: var(--bg-secondary);
            border-right: 1px solid var(--border-color);
            padding: 1.5rem;
            position: sticky;
            top: 0;
            height: 100vh;
            overflow-y: auto;
        }

        .main-content {
            flex: 1;
            padding: 2rem;
            max-width: 100%;
        }

        header {
            margin-bottom: 2rem;
            padding-bottom: 1.5rem;
            border-bottom: 2px solid var(--header-border);
        }

        .theme-toggle {
            background: var(--bg-secondary);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 0.5rem 1rem;
            cursor: pointer;
            font-size: 0.85rem;
            color: var(--text-primary);
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            margin-bottom: 1rem;
            transition: background 0.2s, border-color 0.2s;
        }

        .theme-toggle:hover {
            background: var(--bg-tertiary);
            border-color: var(--accent-primary);
        }

        h1 { font-size: 2rem; color: var(--text-primary); margin-bottom: 0.5rem; }
        .subtitle { color: var(--text-muted); font-size: 1rem; }

        .theme-list {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .theme-nav-item {
            display: block;
            padding: 0.75rem 1rem;
            background: var(--bg-secondary);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            color: var(--text-primary);
            text-decoration: none;
            font-size: 0.9rem;
            transition: all 0.2s;
        }
        .theme-nav-item:hover {
            background: var(--accent-bg);
            border-color: var(--accent-primary);
            color: var(--accent-primary);
        }
        .theme-nav-item.active {
            background: var(--accent-bg);
            border-color: var(--accent-primary);
            color: var(--accent-primary);
            font-weight: 600;
        }

        .theme-count {
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            background: var(--tag-bg);
            color: var(--tag-text);
            padding: 0.15rem 0.5rem;
            border-radius: 9999px;
            font-size: 0.7rem;
            font-weight: 500;
            margin-left: 0.5rem;
        }

        .theme-toggle {
            background: var(--bg-secondary);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 0.5rem 1rem;
            cursor: pointer;
            font-size: 0.85rem;
            color: var(--text-primary);
            display: inline-flex;
            align-items: center;
