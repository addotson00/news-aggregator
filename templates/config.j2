<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Feeds & Configuration — Higher Ed + AI Daily Briefing</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --bg-primary: #f5f5f4;
            --bg-secondary: #ffffff;
            --bg-tertiary: #e7e5e4;
            --text-primary: #1c1917;
            --text-secondary: #44403c;
            --text-muted: #78716c;
            --text-subtle: #a8a29e;
            --border-color: #d6d3d1;
            --accent-primary: #1e40af;
            --accent-hover: #1e3a8a;
            --accent-bg: #dbeafe;
            --shadow-sm: 0 1px 2px rgba(0,0,0,0.04);
            --shadow-md: 0 4px 6px rgba(0,0,0,0.06);
            --shadow-lg: 0 10px 15px rgba(0,0,0,0.08);
            --ai-badge-bg: #fef9c3;
            --ai-badge-text: #854d0e;
            --stats-bg: #f5f5f4;
            --header-border: #d6d3d1;
            --tag-bg: #eff6ff;
            --tag-text: #1e40af;
            --ai-score-bg: #fef9c3;
            --ai-score-text: #854d0e;
        }

        [data-theme="dark"] {
            --bg-primary: #0c0a09;
            --bg-secondary: #1c1917;
            --bg-tertiary: #292524;
            --text-primary: #fafaf9;
            --text-secondary: #d6d3d1;
            --text-muted: #a8a29e;
            --text-subtle: #78716c;
            --border-color: #292524;
            --accent-primary: #60a5fa;
            --accent-hover: #93c5fd;
            --accent-bg: #1e3a5f;
            --shadow-sm: 0 1px 2px rgba(0,0,0,0.4);
            --shadow-md: 0 4px 6px rgba(0,0,0,0.4);
            --shadow-lg: 0 10px 15px rgba(0,0,0,0.5);
            --ai-badge-bg: #713f12;
            --ai-badge-text: #fde047;
            --stats-bg: #1c1917;
            --header-border: #292524;
            --tag-bg: #1e3a5f;
            --tag-text: #93c5fd;
            --ai-score-bg: #713f12;
            --ai-score-text: #fde047;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
            line-height: 1.65;
            color: var(--text-primary);
            background: var(--bg-primary);
            max-width: 100%;
            margin: 0;
            padding: 0;
            transition: background-color 0.3s ease, color 0.3s ease;
        }

        .app-container {
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            width: 280px;
            background: var(--bg-secondary);
            border-right: 1px solid var(--border-color);
            padding: 1.5rem;
            position: sticky;
            top: 0;
            height: 100vh;
            overflow-y: auto;
        }

        .main-content {
            flex: 1;
            padding: 2rem;
            max-width: 100%;
        }

        header {
            margin-bottom: 2rem;
            padding-bottom: 1.5rem;
            border-bottom: 2px solid var(--header-border);
        }

        .theme-toggle {
            background: var(--bg-secondary);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 0.5rem 1rem;
            cursor: pointer;
            font-size: 0.85rem;
            color: var(--text-primary);
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            margin-bottom: 1rem;
            transition: background 0.2s, border-color 0.2s;
        }

        .theme-toggle:hover {
            background: var(--bg-tertiary);
            border-color: var(--accent-primary);
        }

        h1 { font-size: 2rem; color: var(--text-primary); margin-bottom: 0.5rem; }
        .subtitle { color: var(--text-muted); font-size: 1rem; }

        .section { margin-bottom: 3rem; }
        .section-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1.5rem;
            padding-bottom: 0.75rem;
            border-bottom: 2px solid var(--header-border);
        }
        .section-header h2 { font-size: 1.5rem; color: var(--text-primary); font-weight: 600; }

        .feed-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
            gap: 1rem;
        }

        .feed-card {
            background: var(--bg-secondary);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 1.25rem;
            transition: transform 0.15s, box-shadow 0.15s, border-color 0.2s;
        }
        .feed-card:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
            border-color: var(--accent-primary);
        }
        .feed-title {
            font-size: 1.05rem;
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 0.5rem;
        }
        .feed-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
            font-size: 0.78rem;
            color: var(--text-muted);
            margin-bottom: 0.75rem;
        }
        .feed-link {
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            padding: 0.4rem 0.75rem;
            background: var(--accent-bg);
            color: var(--accent-primary);
            border-radius: 6px;
            font-size: 0.8rem;
            font-weight: 500;
            text-decoration: none;
            transition: background 0.2s, color 0.2s;
        }
        .feed-link:hover {
            background: var(--accent-primary);
            color: white;
        }

        .theme-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 1rem;
        }

        .theme-card {
            background: var(--bg-secondary);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 1.25rem;
            transition: transform 0.15s, box-shadow 0.15s, border-color 0.2s;
        }
        .theme-card:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
            border-color: var(--accent-primary);
        }
        .theme-title {
            font-size: 1.1rem;
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 0.5rem;
        }
        .theme-keywords {
            display: flex;
            flex-wrap: wrap;
            gap: 0.35rem;
            font-size: 0.75rem;
        }
        .keyword-tag {
            background: var(--tag-bg);
            color: var(--tag-text);
            padding: 0.15rem 0.5rem;
            border-radius: 9999px;
            font-size: 0.7rem;
            font-weight: 500;
        }

        .yaml-block {
            background: var(--bg-tertiary);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 1.25rem;
            overflow-x: auto;
            font-family: 'Monaco', 'Menlo', 'Ubuntu Mono', monospace;
            font-size: 0.8rem;
            line-height: 1.6;
            color: var(--text-secondary);
            white-space: pre-wrap;
            word-wrap: break-word;
        }

        .section { margin-bottom: 3rem; }
        .section-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1.5rem;
            padding-bottom: 0.75rem;
            border-bottom: 2px solid var(--header-border);
        }
        .section-header h2 { font-size: 1.5rem; color: var(--text-primary); font-weight: 600; }
        .section-header .count { color: var(--text-muted); font-size: 0.9rem; font-weight: 400; }

        .stats-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
            padding: 1rem;
            background: var(--bg-secondary);
            border-radius: 10px;
            box-shadow: var(--shadow-sm);
            flex-wrap: wrap;
            gap: 1rem;
        }
        .stat { text-align: center; }
        .stat-value { font-size: 1.5rem; font-weight: 700; color: var(--accent-primary); }
        .stat-label { font-size: 0.7rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; }

        .theme-toggle {
            background: var(--bg-secondary);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 0.5rem 1rem;
            cursor: pointer;
            font-size: 0.85rem;
            color: var(--text-primary);
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            margin-bottom: 1rem;
            transition: background 0.2s, border-color 0.2s;
        }

        .theme-toggle:hover {
            background: var(--bg-tertiary);
            border-color: var(--accent-primary);
        }

        h1 { font-size: 2rem; color: var(--text-primary); margin-bottom: 0.5rem; }
        .subtitle { color: var(--text-muted); font-size: 1rem; }
        .meta { color: var(--text-subtle); font-size: 0.9rem; margin-top: 0.5rem; }

        @media (max-width: 900px) {
            .app-container { flex-direction: column; }
            .sidebar {
                width: 100%;
                border-right: none;
                border-bottom: 1px solid var(--border-color);
                position: relative;
                height: auto;
            }
            .main-content { padding: 1.5rem 1rem; }
        }

        @media (max-width: 600px) {
            body { padding: 1rem; }
            h1 { font-size: 1.8rem; }
        }
    </style>
</head>
<body>
    <div class="app-container">
        <aside class="sidebar">
            <div style="margin-bottom: 1.5rem;">
                <h1 style="font-size: 1.3rem; margin-bottom: 0.25rem;">Higher Ed + AI</h1>
                <div class="subtitle">Daily Briefing</div>
            </div>

            <button class="theme-toggle" id="themeToggle" aria-label="Toggle dark mode">
                <span id="themeIcon">🌙</span>
                <span id="themeText">Dark</span>
            </button>

            <nav style="margin-top: 1.5rem;">
                <a href="index.html" style="display: block; padding: 0.5rem 0; color: var(--text-primary); text-decoration: none; border-bottom: 1px solid var(--border-color);">
                    🎯 AI Briefing
                </a>
                <a href="all.html" style="display: block; padding: 0.5rem 0; color: var(--text-primary); text-decoration: none; border-bottom: 1px solid var(--border-color);">
                    📚 All Articles
                </a>
                <a href="theme.html" style="display: block; padding: 0.5rem 0; color: var(--text-primary); text-decoration: none; border-bottom: 1px solid var(--border-color);">
                    🏷️ By Theme
                </a>
                <a href="config.html" style="display: block; padding: 0.5rem 0; color: var(--text-primary); text-decoration: none; border-bottom: 1px solid var(--border-color); font-weight: 600;">
                    ⚙️ Feeds & Config
                </a>
            </nav>
        </aside>

        <main class="main-content">
            <header>
                <h1>Feeds & Configuration</h1>
                <div class="subtitle">Manage feeds, view taxonomy, and customize the briefing</div>
            </header>

            <div class="stats-bar">
                <div class="stat">
                    <div class="stat-value">{{ feeds|length }}</div>
                    <div class="stat-label">Total Feeds</div>
                </div>
                <div class="stat">
                    <div class="stat-value">{{ feeds_by_category|length }}</div>
                    <div class="stat-label">Categories</div>
                </div>
                <div class="stat">
                    <div class="stat-value">{{ taxonomy.themes|length }}</div>
                    <div class="stat-label">Themes</div>
                </div>
                <div class="stat">
                    <div class="stat-value">{{ taxonomy.ai_boost_keywords|length }}</div>
                    <div class="stat-label">AI Keywords</div>
                </div>
            </div>

            <section class="section">
                <div class="section-header">
                    <h2>📡 RSS Feeds by Category</h2>
                    <span class="count">{{ feeds|length }} feeds</span>
                </div>
                <div class="feed-grid">
                    {% for category, feeds in feeds_by_category.items() %}
                    <div class="feed-card" style="grid-column: 1 / -1; background: var(--bg-tertiary); border-left: 4px solid var(--accent-primary);">
                        <h3 style="font-size: 1rem; font-weight: 600; color: var(--text-primary); margin-bottom: 0.75rem;">{{ category }}</h3>
                        <div class="feed-grid">
                            {% for feed in feeds %}
                            <div class="feed-card">
                                <div class="feed-title">{{ feed.title }}</div>
                                <div class="feed-meta">
                                    <span>📂 {{ feed.category }}</span>
                                </div>
                                {% if feed.html_url %}
                                <a href="{{ feed.html_url }}" target="_blank" rel="noopener" class="feed-link">Visit Site</a>
                                {% endif %}
                                {% if feed.url %}
                                <a href="{{ feed.url }}" target="_blank" rel="noopener" class="feed-link" style="background: var(--bg-tertiary); color: var(--text-muted);">RSS Feed</a>
                                {% endif %}
                            </div>
                            {% endfor %}
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </section>

            <section class="section">
                <div class="section-header">
                    <h2>🏷️ Theme Taxonomy</h2>
                    <span class="count">{{ taxonomy.themes|length }} themes</span>
                </div>
                <div class="theme-grid">
                    {% for theme, config in taxonomy.themes.items() %}
                    <div class="theme-card">
                        <div class="theme-title">{{ theme }}</div>
                        <div class="theme-keywords">
                            {% for kw in config.keywords %}
                            <span class="keyword-tag">{{ kw }}</span>
                            {% endfor %}
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </section>

            <section class="section">
                <div class="section-header">
                    <h2>🤖 AI Boost Keywords</h2>
                    <span class="count">{{ taxonomy.ai_boost_keywords|length }} keywords</span>
                </div>
                <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
                    {% for kw in taxonomy.ai_boost_keywords %}
                    <span class="keyword-tag" style="background: var(--ai-badge-bg); color: var(--ai-badge-text);">{{ kw }}</span>
                    {% endfor %}
                </div>
            </section>

            <section class="section">
                <div class="section-header">
                    <h2>⚙️ Scoring Configuration</h2>
                </div>
                <div class="yaml-block">
scoring:
  title_match_boost: {{ taxonomy.scoring.title_match_boost }}
  ai_keyword_weight: {{ taxonomy.scoring.ai_keyword_weight }}
  theme_keyword_weight: {{ taxonomy.scoring.theme_keyword_weight }}
  min_ai_score_for_ai_section: {{ taxonomy.scoring.min_ai_score_for_ai_section }}
                </div>
            </section>

            <section class="section">
                <div class="section-header">
                    <h2>📥 Export / Import</h2>
                </div>
                <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
                    <a href="feeds.opml" download class="feed-link" style="background: var(--accent-bg); color: var(--accent-primary);">Download feeds.opml</a>
                    <a href="taxonomy.yaml" download class="feed-link" style="background: var(--bg-tertiary); color: var(--text-primary);">Download taxonomy.yaml</a>
                    <a href="briefing.json" target="_blank" class="feed-link" style="background: var(--bg-tertiary); color: var(--text-primary);">View briefing.json</a>
                </div>
            </section>

            <footer style="margin-top: 3rem; padding-top: 1.5rem; border-top: 2px solid var(--header-border); text-align: center; color: var(--text-subtle); font-size: 0.85rem;">
                <p>Generated by <a href="https://github.com/addotson00/news-aggregator" target="_blank" rel="noopener">Higher Ed + AI Briefing</a> on {{ generated_utc }}</p>
                <p><a href="index.html">AI Briefing</a> | <a href="all.html">All Articles</a> | <a href="theme.html">By Theme</a> | <a href="briefing.json" target="_blank">JSON Data</a></p>
            </footer>

        </main>
    </div>

    <script>
        (function() {
            const toggle = document.getElementById('themeToggle');
            const icon = document.getElementById('themeIcon');
            const text = document.getElementById('themeText');
            const html = document.documentElement;

            const savedTheme = localStorage.getItem('theme');
            const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;

            function applyTheme(theme) {
                html.setAttribute('data-theme', theme);
                localStorage.setItem('theme', theme);
                if (theme === 'dark') {
                    icon.textContent = '☀️';
                    text.textContent = 'Light';
                } else {
                    icon.textContent = '🌙';
                    text.textContent = 'Dark';
                }
            }

            if (savedTheme) {
                applyTheme(savedTheme);
            } else if (prefersDark) {
                applyTheme('dark');
            } else {
                applyTheme('light');
            }

            document.getElementById('themeToggle').addEventListener('click', function() {
                const currentTheme = html.getAttribute('data-theme');
                const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
                applyTheme(newTheme);
            });

            window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function(e) {
                if (!localStorage.getItem('theme')) {
                    applyTheme(e.matches ? 'dark' : 'light');
                }
            });
        })();
    </script>
</body>
</html>